#ifndef CLAUDEINSTALLCONFIG_H
#define CLAUDEINSTALLCONFIG_H

#define CMAKE_INSTALL_PREFIX "${CMAKE_INSTALL_PREFIX}"
#define CMAKE_INSTALL_FULL_LIBEXECDIR "${CMAKE_INSTALL_FULL_LIBEXECDIR}"
#define CMAKE_INSTALL_LIBDIR "${CMAKE_INSTALL_LIBDIR}"
#define CMAKE_INSTALL_FULL_LIBDIR "${CMAKE_INSTALL_FULL_LIBDIR}"
#define CMAKE_INSTALL_FULL_DATADIR "${CMAKE_INSTALL_FULL_DATADIR}/claudeinstall"
#define CMAKE_INSTALL_FULL_SYSCONFDIR "${CMAKE_INSTALL_FULL_SYSCONFDIR}"
#define CMAKE_BUILD_TYPE "${CMAKE_BUILD_TYPE}"

/*
 * These are feature-settings that affect consumers of ClaudeInstall
 * libraries as well; without QML-support in the libs, for instance,
 * there's no point in having a QML view module.
 *
 * This list should match the one in ClaudeInstallConfig.cmake
 * which is the CMake-time side of the same configuration.
 */
#cmakedefine WITH_QML
#cmakedefine WITH_QT6

#endif  // CLAUDEINSTALLCONFIG_H
